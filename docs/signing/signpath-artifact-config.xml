<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for Kensaku release builds.

  How to use it:
    1. In SignPath, open the Kensaku project and add an Artifact
       Configuration (Add -> Custom), then paste this file.
    2. Name its slug `kensaku-binaries` (or change
       SIGNPATH_ARTIFACT_CONFIGURATION_SLUG to match).

  The release workflow uploads directories with actions/upload-artifact,
  which stores them as a ZIP archive, so the root element is <zip-file>.

  The release workflow uploads one `kensaku.exe` per Windows target.

  Do not add description/description-url to <authenticode-sign>: the Open
  Source Code Signing subscription enforces an automatically generated
  watermark, and SignPath rejects the whole configuration if they are set.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="kensaku.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
